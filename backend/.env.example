# PostgreSQL
DATABASE_URL="postgresql://supervision:supervision@127.0.0.1:5432/supervision?schema=public"

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT
JWT_SECRET=change-me-supervision-pfa-secret-key-2026
JWT_EXPIRES_IN=24h

# Agent / heartbeat
HEARTBEAT_TIMEOUT_SECONDS=30
HEARTBEAT_CHECK_INTERVAL_SECONDS=10

# CORS (dashboard + mobile)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
